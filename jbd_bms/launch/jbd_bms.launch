<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <arg
    name="port"
    default="$(env ROBOT_BMS_PORT /dev/ttyUSB_BMS)"
  />
  <arg
    name="desired_freq"
    default="$(env DESIRED_FREQ 2.0)"
  />
  <arg
    name="node_name"
    default="$(env NODE_NAME battery_estimator)"
  />
  <arg
    name="robot_id"
    default="$(env ROBOT_ID robot)"
  />

  <arg
    name="log_level"
    default="$(env LOG_LEVEL INFO)"
  />

  <node
    pkg="jbd"
    exec="jbd_bms_node"
    name="$(var node_name)"
    namespace="/$(var robot_id)"
    ros_args="--log-level $(var log_level)"
    output="screen"
  >
    <param
      name="serial_port"
      value="$(var port)"
    />
    <param
      name="publish_freq"
      value="$(var desired_freq)"
    />
  </node>

</launch>