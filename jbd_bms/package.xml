<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jbd_bms</name>
  <version>0.2.0</version>
  <description>JBD Smart Battery management system</description>

  <maintainer email="jgomez@robotnik.es">José Gómez</maintainer>
  <maintainer email="ggari@robotnik.es">Guillem Gari</maintainer>
  <license>BSD 3-Clause License</license>
  <url type="website">http://www.robotnink.eu</url>

  <author email="jgomez@robotnik.es">José Gómez</author>

  <build_depend>rclpy</build_depend>
  <build_depend>robotnik_battery_msgs</build_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robotnik_battery_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-serial</exec_depend>


  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_python</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
